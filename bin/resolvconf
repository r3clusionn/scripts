#!/bin/sh
# Minimal resolvconf for iwd (replaces openresolv): iwd runs
#   resolvconf -a <ifname>.dns|.domain   (nameserver/search lines on stdin)
#   resolvconf -d <ifname>.dns|.domain
# Each entry is kept in /run/resolvconf/interfaces; /etc/resolv.conf is rebuilt
# from all of them. -u only rebuilds. Other openresolv options are ignored.
set -eu
d=${RESOLVCONF_DIR:-/run/resolvconf/interfaces}
out=${RESOLV_CONF:-/etc/resolv.conf}
op= name=
while [ $# -gt 0 ]; do
	case $1 in
	-a|-d) op=$1; name=${2:-}; shift; [ $# -gt 0 ] && shift ;;
	-u) op=-u; shift ;;
	-m|-p) shift; [ $# -gt 0 ] && shift ;;
	*) shift ;;
	esac
done
case $name in */*|.*) echo "resolvconf: bad name '$name'" >&2; exit 1 ;; esac
mkdir -p "$d"
case $op in
-a) [ -n "$name" ] || exit 1; cat > "$d/.$name"; mv "$d/.$name" "$d/$name" ;;
-d) [ -n "$name" ] || exit 1; rm -f "$d/$name" ;;
-u) ;;
*) echo "usage: resolvconf -a NAME < config | -d NAME | -u" >&2; exit 1 ;;
esac
set -- "$d"/*
[ -e "$1" ] || set --
{
	echo "# Generated by resolvconf"
	s=$(cat "$@" </dev/null | sed -n 's/^[[:space:]]*\(search\|domain\)[[:space:]]\{1,\}//p' | tr '\n' ' ')
	s=${s% }
	[ -z "$s" ] || echo "search $s"
	cat "$@" </dev/null | grep -E '^[[:space:]]*(nameserver|options|sortlist)[[:space:]]' | awk '!seen[$0]++' || true
} > "$out.new"
mv "$out.new" "$out"
