#!/bin/sh
# powerprofile: power plans for the HP OmniBook 7 (Ryzen AI 9 HX 475).
#
#   powerprofile battery|balanced|performance|gaming   pick a plan (stays when plugging in or out)
#   powerprofile auto                                   back to automatic (by the power source)
#   powerprofile status                                 the plan and what it set
#   powerprofile plug ac|battery                        from udev on AC changes (only when automatic)
#   powerprofile game|restore                           mclaunch while a game runs (only when automatic)
#
# Plans, from least to most power:
#   battery      EPP power,               no boost, amd-pmf low-power,   hp-wmi cool
#   balanced     EPP balance_power,       boost up to 3.6 GHz, amd-pmf balanced, hp-wmi balanced
#   performance  EPP balance_performance, boost,    amd-pmf performance, hp-wmi performance
#   gaming       EPP performance,         boost,    amd-pmf performance, hp-wmi performance,
#                GPU clocks pinned high (steady frame times)
# Every plan runs the SSD's PCIe link at Gen4 (the BIOS sets Gen3): 6.6 against
# 3.4 GB/s reads, half the energy per GB read, no measurable idle cost.
# Automatic: balanced on battery, performance plugged in.
#
# State in /run/powerprofile: "plan pinned|auto".
state=/run/powerprofile
on_ac() { [ "$(cat /sys/class/power_supply/ACAD/online 2>/dev/null)" = 1 ]; }
auto_plan() { on_ac && echo performance || echo balanced; }

apply() {
  case "$1" in
    battery)     epp=power;               boost=0; cap=0;       pmf=low-power;   hp=cool;        gpu=auto; ssd=0 ;;
    balanced)    epp=balance_power;       boost=1; cap=3600000; pmf=balanced;    hp=balanced;    gpu=auto; ssd=0 ;;
    performance) epp=balance_performance; boost=1; cap=0;       pmf=performance; hp=performance; gpu=auto; ssd=0 ;;
    gaming)      epp=performance;         boost=1; cap=0;       pmf=performance; hp=performance; gpu=high; ssd=0 ;;
    *) echo "powerprofile: unknown plan $1" >&2; exit 1 ;;
  esac
  echo "$boost" > /sys/devices/system/cpu/cpufreq/boost 2>/dev/null
  for d in /sys/devices/system/cpu/cpufreq/policy*; do
    echo "$epp" > "$d/energy_performance_preference"
    # A frequency cap (kHz) for balanced; the others may use the full range.
    max=$(cat "$d/cpuinfo_max_freq")
    [ "$cap" -gt 0 ] && [ "$cap" -lt "$max" ] && max=$cap
    echo "$max" > "$d/scaling_max_freq"
  done
  for pp in /sys/class/platform-profile/platform-profile-*; do
    case "$(cat "$pp/name")" in
      amd-pmf) echo "$pmf" > "$pp/profile" ;;
      hp-wmi)  echo "$hp"  > "$pp/profile" ;;
    esac
  done 2>/dev/null
  for g in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
    echo "$gpu" > "$g"
  done 2>/dev/null
  # SSD link speed through the kernel's PCIe link-speed control for the SSD's
  # root port: 0 = the fastest both ends support (Gen4), 1 = one step lower
  # (Gen3, what the BIOS sets). Measured: 6.6 against 3.4 GB/s, no link errors,
  # idle 4.44 against 4.55 W on battery, 4.7 against 8.7 J to read 6 GiB.
  port=$(basename "$(dirname "$(readlink -f /sys/class/nvme/nvme0/device)")")
  for c in /sys/class/thermal/cooling_device*; do
    [ "$(cat "$c/type")" = "PCIe_Port_Link_Speed_$port" ] && echo "$ssd" > "$c/cur_state"
  done 2>/dev/null
  logger -t powerprofile "$1: epp=$epp boost=$boost cap=$cap pmf=$pmf hp=$hp gpu=$gpu ssd=$ssd" 2>/dev/null || true
}

# The status bar shows the plan (dwmstat reads $state).
bar() { pkill -USR1 -x dwmstat 2>/dev/null || true; }
mode() { cut -d' ' -f2 "$state" 2>/dev/null || echo auto; }

case "$1" in
  battery|balanced|performance|gaming)
    apply "$1"; echo "$1 pinned" > "$state"; bar ;;
  auto|"")
    p=$(auto_plan); apply "$p"; echo "$p auto" > "$state"; bar ;;
  plug)
    [ "$(mode)" = pinned ] && exit 0
    p=$(auto_plan); apply "$p"; echo "$p auto" > "$state"; bar ;;
  game)
    [ "$(mode)" = pinned ] && exit 0
    apply gaming; echo "gaming auto" > "$state"; bar ;;
  restore)
    if [ "$(mode)" = pinned ]; then apply "$(cut -d' ' -f1 "$state")"
    else p=$(auto_plan); apply "$p"; echo "$p auto" > "$state"; fi
    bar ;;
  # The old names, for anything still calling them.
  ac) exec "$0" plug ac ;;
  status)
    read -r plan how < "$state" 2>/dev/null || { plan=unknown; how=auto; }
    echo "plan: $plan ($how)"
    c=/sys/devices/system/cpu/cpufreq/policy0
    echo "cpu: epp $(cat $c/energy_performance_preference), boost $(cat /sys/devices/system/cpu/cpufreq/boost), max $(( $(cat $c/scaling_max_freq) / 1000 )) MHz"
    for pp in /sys/class/platform-profile/platform-profile-*; do echo "$(cat "$pp/name"): $(cat "$pp/profile")"; done
    for g in /sys/class/drm/card*/device/power_dpm_force_performance_level; do echo "gpu: $(cat "$g")"; done
    echo "ssd: $(cat /sys/class/nvme/nvme0/device/current_link_speed 2>/dev/null)"
    exit 0 ;;
  *) echo "usage: powerprofile battery|balanced|performance|gaming|auto|status" >&2; exit 1 ;;
esac
